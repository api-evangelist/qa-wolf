              "name": "environment_terminated",
              "item": [
                {
                  "name": "Notify QA Wolf that an ephemeral environment has been terminated",
                  "id": "07757661-1e21-4f06-b3ab-a8370e937a3b",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
